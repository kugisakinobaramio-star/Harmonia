{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "harmonia",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-15",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "single-page-application"
  },
  "alias": {
    "body-parser": "./worker/body-parser-shim.ts"
  },
  "previews": {}
}
